<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>__PROJECT__</AssemblyName>
    <RootNamespace>__PROJECT__</RootNamespace>
    <!-- Filled by `websiter new`: path to framework src/ for repo checkouts,
         empty for NuGet/dotnet-tool installs (uses PackageReference then). -->
    <WebsiterSrc>__WEBSITER_SRC__</WebsiterSrc>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup Condition="'$(WebsiterSrc)' != ''">
    <ProjectReference Include="$(WebsiterSrc)/Websiter.Runtime/Websiter.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(WebsiterSrc)' == ''">
    <PackageReference Include="Websiter" Version="__WEBSITER_VERSION__" />
  </ItemGroup>
</Project>
