<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Websiter — build without boundaries. Single package containing the full Websiter framework.</Description>
    <PackageId>Websiter</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageTags>websiter;web-framework;aspnetcore;kestrel;workers;ipc</PackageTags>
  </PropertyGroup>

  <!-- Build ordering only; PrivateAssets keeps these out of the nuspec
       dependency list since the assemblies are bundled below. -->
  <ItemGroup>
    <ProjectReference Include="..\Websiter.Core\Websiter.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Websiter.Routing\Websiter.Routing.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Websiter.IPC\Websiter.IPC.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Websiter.Workers\Websiter.Workers.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Websiter.Server\Websiter.Server.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Websiter.Components\Websiter.Components.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Websiter.Frontend\Websiter.Frontend.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Websiter.Native\Websiter.Native.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Websiter.Security\Websiter.Security.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Websiter.Diagnostics\Websiter.Diagnostics.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Websiter.Deployment\Websiter.Deployment.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Websiter.Runtime\Websiter.Runtime.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Bundle every framework assembly into lib/net10.0/. -->
  <ItemGroup>
    <None Include="..\Websiter.Core\bin\$(Configuration)\net10.0\Websiter.Core.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="..\Websiter.Routing\bin\$(Configuration)\net10.0\Websiter.Routing.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="..\Websiter.IPC\bin\$(Configuration)\net10.0\Websiter.IPC.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="..\Websiter.Workers\bin\$(Configuration)\net10.0\Websiter.Workers.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="..\Websiter.Server\bin\$(Configuration)\net10.0\Websiter.Server.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="..\Websiter.Components\bin\$(Configuration)\net10.0\Websiter.Components.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="..\Websiter.Frontend\bin\$(Configuration)\net10.0\Websiter.Frontend.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="..\Websiter.Native\bin\$(Configuration)\net10.0\Websiter.Native.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="..\Websiter.Security\bin\$(Configuration)\net10.0\Websiter.Security.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="..\Websiter.Diagnostics\bin\$(Configuration)\net10.0\Websiter.Diagnostics.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="..\Websiter.Deployment\bin\$(Configuration)\net10.0\Websiter.Deployment.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="..\Websiter.Runtime\bin\$(Configuration)\net10.0\Websiter.Runtime.dll" Pack="true" PackagePath="lib/net10.0/" />
  </ItemGroup>

  <!-- Third-party dependencies consumers still need from NuGet. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
